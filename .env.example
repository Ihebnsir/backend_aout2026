PORT=5000
CORS_ORIGIN=http://localhost:3000
MONGO_URL=
JWT_SECRET=

# Admin default credentials
ADMIN_NAME=SkillBridge
ADMIN_FIRSTNAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ATTACHMENT_STORAGE_DIR=./.attachments
MAX_ATTACHMENT_SIZE=10485760
MAX_ATTACHMENTS_PER_MESSAGE=5

# Local development uses the private local filesystem adapter.
# Production R2 requires a private bucket and all variables below.
ATTACHMENT_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
