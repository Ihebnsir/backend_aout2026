port=5000
CORS_ORIGIN=http://localhost:3000
MONGO_URL=
JWT_SECRET=

# Admin default credentials
ADMIN_NAME=SkillBridge
ADMIN_FIRSTNAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP Configuration for Email Delivery
# Gmail: Use smtp.gmail.com with port 465 and app-specific password
# For Gmail accounts with 2FA, generate an app-specific password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=your-email@gmail.com

# Messaging abuse protection
MESSAGE_RATE_LIMIT_WINDOW_MS=60000
MESSAGE_RATE_LIMIT_MAX=30
